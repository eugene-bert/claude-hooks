# Session Color — auto-tint terminal tabs per project directory
# Works best with iTerm2; basic title-setting works in any terminal.

# Disable entirely (default: true)
# SESSION_COLOR_ENABLED=false

# Terminal type: auto | iterm2 | basic | none (default: auto — detects iTerm2)
# SESSION_COLOR_TERMINAL=auto

# Tint background color (default: true)
# SESSION_COLOR_BG=true

# Background tint strength, 0.0–1.0 (default: 0.12)
# SESSION_COLOR_BG_STRENGTH=0.12

# Show project name as iTerm2 badge watermark (default: false — opt-in, it's big)
# SESSION_COLOR_BADGE=false

# Set terminal/tab title to "claude: <project>" (default: true)
# SESSION_COLOR_TITLE=true
